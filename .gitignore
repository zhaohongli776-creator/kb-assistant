# ══════════════════════════════════════════════════════════════
# kb-assistant · .gitignore
# 原则：密钥与本地产物不进仓库；规则文件和占位模板必须进仓库。
# ══════════════════════════════════════════════════════════════

# ── 1. 密钥与本地配置 ─────────────────────────────────────────
# 真实密钥只写进 .env，绝不入库；.env.example 是占位模板，必须入库
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# ── 2. Python 编译产物与虚拟环境 ──────────────────────────────
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ── 3. 测试与静态检查缓存 ────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── 4. 运行时产物 ────────────────────────────────────────────
# uploads/ 是 D5 的上传落盘目录；data/ 放本机数据库与导出物
uploads/
data/
*.db
*.sqlite3
*.log

# ── 5. 大体积媒体（演示录屏放仓库外面：D:\kb-assistant-demos\）
*.mp4
*.mov
*.mkv

# ── 6. 编辑器与操作系统 ──────────────────────────────────────
.vscode/
.idea/
*.swp
*~
Thumbs.db
.DS_Store
